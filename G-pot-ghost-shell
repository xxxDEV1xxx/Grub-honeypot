class GhostSession:
    """
    The real session — hidden from attacker.

    AMT KVM reads /dev/fb0 which reflects VT1.
    Real work happens on VT7.
    VT switching is locked so attacker can't
    chvt to VT7 even with keyboard injection.
    """

    def __init__(self):
        self.puppet_pid = None
        self.ghost_pid  = None
        self.monitor    = AccessMonitor()

    def lock_vt_switching(self):
        """
        Prevent attacker from switching VTs.
        Their keyboard injection can send chvt
        or Ctrl+Alt+F7 — we block this.
        """
        try:
            # Lock VT from keyboard switching
            # ioctl VT_LOCKSWITCH = 0x5600 + 3
            import fcntl
            fd = os.open('/dev/tty1', os.O_RDWR)
            VT_LOCKSWITCH = 0x5603
            fcntl.ioctl(fd, VT_LOCKSWITCH, 0)
            os.close(fd)
            print("[GHOST] VT switching locked")
        except Exception as e:
            print(f"[GHOST] VT lock: {e}")

    def start_puppet(self):
        """Fork puppet onto VT1"""
        master, slave = pty.openpty()

        pid = os.fork()
        if pid == 0:
            # Child — puppet process on VT1
            os.setsid()

            # Connect to VT1
            fd = os.open('/dev/tty1', os.O_RDWR)
            for i in range(3):
                os.dup2(fd, i)
            os.close(fd)

            # Run shell for puppet to control
            os.execv('/bin/bash', ['/bin/bash', '--norc', '--noprofile'])
            os._exit(1)

        self.puppet_pid = pid

        # Drive puppet from master PTY
        puppet = PuppetTerminal()
        puppet_thread = threading.Thread(
            target=puppet.run,
            args=(master,),
            daemon=True
        )
        puppet_thread.start()

        print(f"[GHOST] Puppet started PID={pid}")
        return master

    def start_ghost(self):
        """Fork real session onto VT7"""
        pid = os.fork()
        if pid == 0:
            os.setsid()
            # Connect to VT7
            fd = os.open('/dev/tty7', os.O_RDWR)
            for i in range(3):
                os.dup2(fd, i)
            os.close(fd)
            # Start real bash — full featured
            os.execv('/bin/bash',
                ['/bin/bash', '-i', '--login'])
            os._exit(1)

        self.ghost_pid = pid
        print(f"[GHOST] Real session PID={pid} on VT7")
        print(f"[GHOST] Switch to VT7: chvt 7")
        print(f"[GHOST] Or: ssh user@localhost")


