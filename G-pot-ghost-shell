class HumanTypingEngine:
    """
    Simulates realistic human typing patterns
    including thinking pauses, typos, corrections
    and reading behavior (scroll, pause, scroll)
    """

    def __init__(self, output_fd):
        self.out    = output_fd
        self.speed  = random.uniform(0.8, 1.2)  # Individual speed factor

    def write(self, text):
        os.write(self.out, text.encode() if isinstance(text, str) else text)

    def type_char(self, char):
        """Type a single character with realistic delay"""
        delay = random.gauss(
            (MIN_KEYSTROKE + MAX_KEYSTROKE) / 2,
            (MAX_KEYSTROKE - MIN_KEYSTROKE) / 4
        ) * self.speed
        delay = max(MIN_KEYSTROKE, min(MAX_KEYSTROKE, delay))
        time.sleep(delay)

        # Random typo
        if random.random() < TYPO_RATE and char.isalpha():
            # Type wrong key (adjacent key on keyboard)
            adjacent = self._adjacent_key(char)
            self.write(adjacent)
            time.sleep(BACKSPACE_DLY)
            self.write('\x7f')  # Backspace
            time.sleep(0.05)

        self.write(char)

    def _adjacent_key(self, char):
        """Return a keyboard-adjacent character for typo simulation"""
        rows = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm']
        for row in rows:
            idx = row.find(char.lower())
            if idx >= 0:
                neighbors = []
                if idx > 0: neighbors.append(row[idx-1])
                if idx < len(row)-1: neighbors.append(row[idx+1])
                if neighbors:
                    typo = random.choice(neighbors)
                    return typo.upper() if char.isupper() else typo
        return char

    def type_command(self, cmd):
        """Type a full command with human-like behavior"""
        # Thinking pause before typing
        think = random.uniform(THINK_MIN, THINK_MAX)
        time.sleep(think)

        for char in cmd:
            self.type_char(char)

        # Pause before Enter (reviewing command)
        time.sleep(random.uniform(0.3, 1.2))
        self.write('\n')

    def scroll_output(self, lines=20):
        """Simulate reading output — pauses at interesting lines"""
        for i in range(lines):
            # Occasionally pause as if reading
            if random.random() < 0.15:
                time.sleep(random.uniform(1.0, 3.0))
            else:
                time.sleep(random.uniform(0.02, 0.08))

    def think(self, min_t=None, max_t=None):
        """General thinking pause"""
        t = random.uniform(
            min_t or THINK_MIN,
            max_t or THINK_MAX
        )
        time.sleep(t)


