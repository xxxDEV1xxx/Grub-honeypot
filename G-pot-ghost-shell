class AccessMonitor:
    """
    Monitors for attacker behavior changes
    in response to puppet activity.

    Key behavioral indicators:
    - Response timing to puppet 'discoveries'
    - Module loads after specific puppet actions
    - Network connections triggered by puppet cmds
    - USB events correlated with puppet activity
    """

    def __init__(self):
        self.events     = []
        self.baselines  = {}
        os.makedirs(EVIDENCE_DIR, exist_ok=True)
        self.log_file   = os.path.join(
            EVIDENCE_DIR,
            f'behavior_{int(time.time())}.log'
        )

    def log(self, event_type, data):
        ts = datetime.now().isoformat()
        entry = f"[{ts}] {event_type}: {data}"
        self.events.append({
            'ts': ts,
            'type': event_type,
            'data': data
        })
        with open(self.log_file, 'a') as f:
            f.write(entry + '\n')
        print(f"[MONITOR] {entry}")

    def baseline_modules(self):
        """Record module state for comparison"""
        result = subprocess.run(
            ['lsmod'],
            capture_output=True, text=True
        )
        self.baselines['modules'] = set(
            line.split()[0]
            for line in result.stdout.splitlines()[1:]
        )

    def baseline_network(self):
        """Record network state"""
        result = subprocess.run(
            ['ss', '-tupan'],
            capture_output=True, text=True
        )
        self.baselines['network'] = result.stdout

    def check_modules(self):
        """Detect new modules since baseline"""
        result = subprocess.run(
            ['lsmod'],
            capture_output=True, text=True
        )
        current = set(
            line.split()[0]
            for line in result.stdout.splitlines()[1:]
        )
        new = current - self.baselines.get('modules', set())
        for mod in new:
            self.log('NEW_MODULE', mod)
        return new

    def check_network(self):
        """Detect new connections"""
        result = subprocess.run(
            ['ss', '-tupan'],
            capture_output=True, text=True
        )
        current = result.stdout
        baseline = self.baselines.get('network', '')
        new_lines = set(current.splitlines()) - \
                    set(baseline.splitlines())
        for line in new_lines:
            if line.strip():
                self.log('NEW_CONNECTION', line.strip())

    def run(self, puppet_log):
        """
        Main monitoring loop.
        Correlates attacker behavior changes
        with puppet actions.
        """
        self.baseline_modules()
        self.baseline_network()

        self.log('MONITOR_START', 'Baselines established')

        while True:
            time.sleep(1.0)

            # Check for behavioral changes
            new_mods = self.check_modules()
            self.check_network()

            # Correlate with recent puppet actions
            if new_mods and puppet_log:
                recent = puppet_log[-3:] if puppet_log else []
                self.log(
                    'CORRELATION',
                    f"New modules {new_mods} after "
                    f"puppet actions: {recent}"
                )

            # Check if they're watching —
            # framebuffer read rate increases
            # when content changes (KVM polling)
            fb_stat = os.stat(FB_DEVICE) \
                if os.path.exists(FB_DEVICE) else None
            if fb_stat:
                # atime changes = being read
                pass


